<Window x:Class="ProjectManager.Screens.EditProjectScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Project"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowState="Maximized"
        Background="#F5F5F5"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Border Background="White" CornerRadius="8" Padding="20" 
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Columns="2" Rows="0" Margin="0,0,0,20" HorizontalAlignment="Stretch">
                        <StackPanel Margin="10">
                            <TextBlock Text="Project Details" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedProject.ProjectDetails}" />
                        </StackPanel>

                        <StackPanel Margin="10">
                            <TextBlock Text="Project Price" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedProject.ProjectPrice}" />
                        </StackPanel>

                        <StackPanel Margin="10">
                            <TextBlock Text="Owner Name" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedProject.OwnerName}" />
                        </StackPanel>

                        <StackPanel Margin="10">
                            <TextBlock Text="Commercial Register" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedProject.OwnerCommercialRegister}" />
                        </StackPanel>

                        <StackPanel Margin="10">
                            <TextBlock Text="Owner Phone" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedProject.OwnerPhone}" />
                        </StackPanel>

                        <StackPanel Margin="10">
                            <TextBlock Text="System Details" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedProject.OwnerSystemDetails}" />
                        </StackPanel>

                        <StackPanel Margin="10">
                            <TextBlock Text="Notes" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedProject.Notes}" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Save Changes" Command="{Binding SaveCommand}" Width="120" Height="35" Margin="5"/>
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Width="100" Height="35" Margin="5"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

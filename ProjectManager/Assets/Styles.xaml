<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 🎨 Color Palette -->
    <Color x:Key="PrimaryColor">#7D1C4A</Color>
    <Color x:Key="SecondaryColor">#D17D98</Color>
    <Color x:Key="BackgroundColor">#E5E4E2</Color>
    <Color x:Key="DarkAccent">#56021F</Color>

    <!-- 🖌️ SolidColorBrushes for UI -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="DarkAccentBrush" Color="{StaticResource DarkAccent}" />

    <!-- 🔤 Font Styles -->
    <Style x:Key="HeadingText" TargetType="TextBlock">
        <Setter Property="FontFamily" 
                Value="pack://application:,,,/Assets/Fonts/Poppins.ttf#Poppins"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Foreground" Value="{StaticResource DarkAccentBrush}" />
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" 
                Value="pack://application:,,,/Assets/Fonts/inter.ttf#Inter"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    </Style>

    <!-- 🔘 Button Style -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" 
                Value="pack://application:,,,/Assets/Fonts/Poppins.ttf#Poppins"/>
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="BorderThickness" Value="0"/>

        <!-- Custom Template to Support Rounded Corners -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

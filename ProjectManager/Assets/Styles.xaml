<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- Button Style -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="Audiowide" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="5" />
    </Style>

    <Style x:Key="OutlinedButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Audiowide" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- TextBox Style -->
    <Style x:Key="MaterialDesignOutlinedTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- DataGrid Style -->
    <Style x:Key="MaterialDesignDataGrid" TargetType="DataGrid">
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Background" Value="White" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="ConsumerRowStyle" TargetType="DataGridRow">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Inactive">
                <Setter Property="Background" Value="LightGray"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Prospect">
                <Setter Property="Background" Value="LightBlue"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Lead">
                <Setter Property="Background" Value="LightGoldenrodYellow"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Follow_up_Needed">
                <Setter Property="Background" Value="LightCoral"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Converted">
                <Setter Property="Background" Value="LightGreen"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Churned">
                <Setter Property="Background" Value="OrangeRed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Lost">
                <Setter Property="Background" Value="Tomato"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Default">
                <Setter Property="Background" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- ComboBox Style -->
    <Style x:Key="MaterialDesignComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Heading Text Style -->
    <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Audiowide" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- Body Text Style -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="RoundedProgressBar" TargetType="ProgressBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <!-- Background Track -->
                        <Border x:Name="PART_Track"
                                CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                Height="{TemplateBinding Height}"/>

                        <!-- Progress Indicator -->
                        <Border x:Name="PART_Indicator"
                                CornerRadius="5"
                                Background="{TemplateBinding Foreground}"
                                Height="{TemplateBinding Height}"
                                HorizontalAlignment="Left"/>

                        <!-- Indeterminate Animation -->
                        <Grid x:Name="Animation" Visibility="Collapsed">
                            <Border CornerRadius="5" Height="{TemplateBinding Height}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="{TemplateBinding Foreground}" Offset="0.4"/>
                                        <GradientStop Color="{TemplateBinding Foreground}" Offset="0.6"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="Animation" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="#FFDDDDDD"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Height" Value="10"/>
    </Style>

</ResourceDictionary>

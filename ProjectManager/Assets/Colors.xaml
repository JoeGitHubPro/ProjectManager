<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand Colors -->
    <Color x:Key="PrimaryColor">#1877F2</Color>
    <!-- Bright Blue -->
    <Color x:Key="DarkColor">#07223F</Color>
    <!-- Dark Navy -->
    <Color x:Key="AccentColor">#4A6CA3</Color>
    <!-- Light Blue Accent -->
    <Color x:Key="WhiteColor">#FFFFFF</Color>
    <!-- White -->

    <Color x:Key="SecondaryColor">#4A6CA3</Color>
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="TextColor">#07223F</Color>
    <Color x:Key="BorderColor">#4A6CA3</Color>
    <Color x:Key="InformationColor">#1b08c7</Color>
    <Color x:Key="WarningColor">#fcba03</Color>
    <Color x:Key="ErorrColor">#e00215</Color>
    
    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="DarkBrush" Color="{StaticResource DarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="InformationBrush" Color="{StaticResource InformationColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErorrBrush" Color="{StaticResource ErorrColor}" />

</ResourceDictionary>

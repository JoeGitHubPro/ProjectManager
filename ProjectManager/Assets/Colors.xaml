<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand Colors -->
    <Color x:Key="PrimaryColor">#1877F2</Color>
    <!-- Bright Blue -->
    <Color x:Key="DarkColor">#07223F</Color>
    <!-- Dark Navy -->
    <Color x:Key="AccentColor">#4A6CA3</Color>
    <!-- Light Blue Accent -->
    <Color x:Key="WhiteColor">#FFFFFF</Color>
    <!-- White -->

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="DarkBrush" Color="{StaticResource DarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}"/>


</ResourceDictionary>

<UserControl x:Class="ProjectManager.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ProjectManager.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:packIcon="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search and Action Bar -->
        <Border Grid.Row="0" 
                BorderThickness="0 0 0 1" Padding="0 0 0 5" Margin="0 0 0 10">
            <DockPanel>
                <!-- Search Box -->
                <TextBox DockPanel.Dock="Left" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Search projects..."
                         Width="250" Margin="0 0 10 0"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Action Buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0 0 10 0"
                            Width="80">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"/>
                    </Button>
                    <Button
                            Command="{Binding AddNewCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Width="100">
                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Project List -->
            <Border Grid.Column="0" 
                    BorderThickness="1" CornerRadius="4" Padding="1">
                <DataGrid ItemsSource="{Binding FilteredProjects}"
                          SelectedItem="{Binding SelectedProject}"
                          AutoGenerateColumns="False"
                          Style="{StaticResource MaterialDesignDataGrid}"
                          GridLinesVisibility="None"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          ColumnHeaderHeight="35"
                          RowHeight="35"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="Auto"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding ProjectCategory.Name}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Form Controls -->
            <Border Grid.Column="2" 
                    BorderThickness="1" CornerRadius="4" Padding="15"
                    >
                <StackPanel>
                    <TextBlock Text="Project Details" 
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="0 0 0 15"/>

                    <!-- Name Field -->
                    <TextBox materialDesign:HintAssist.Hint="Project name"
                             Text="{Binding SelectedProject.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0 0 0 10"/>
                    <TextBlock Text="{Binding SelectedProject.ErrorCollection[Name]}"
                               Foreground="Red" Margin="0 -10 0 10" TextWrapping="Wrap"/>

                    <!-- Details Field -->
                    <TextBox materialDesign:HintAssist.Hint="Project details"
                             Text="{Binding SelectedProject.Details, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0 0 0 10"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
                    <TextBlock Text="{Binding SelectedProject.ErrorCollection[Details]}"
                               Foreground="Red" Margin="0 -10 0 10" TextWrapping="Wrap"/>

                    <!-- Price Field -->
                    <TextBox materialDesign:HintAssist.Hint="Price"
                             Text="{Binding SelectedProject.Price, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0 0 0 10"/>
                    <TextBlock Text="{Binding SelectedProject.ErrorCollection[Price]}"
                               Foreground="Red" Margin="0 -10 0 10" TextWrapping="Wrap"/>

                    <!-- Category Field -->
                    <ComboBox materialDesign:HintAssist.Hint="Project category"
                              ItemsSource="{Binding ProjectCategories}"
                              SelectedValue="{Binding SelectedProject.ProjectCategoryId, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0 0 0 15"/>
                    <TextBlock Text="{Binding SelectedProject.ErrorCollection[ProjectCategoryId]}"
                               Foreground="Red" Margin="0 -15 0 10" TextWrapping="Wrap"/>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button 
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0 0 10 0"
                                Width="80">
                            <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16"/>
                        </Button>
                        <Button 
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="80"
                                IsEnabled="{Binding CanDelete}">
                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
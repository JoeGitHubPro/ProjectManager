<UserControl x:Class="ProjectManager.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0 0 0 10" LastChildFill="False">
            <TextBox Width="250"
                     Margin="0 0 10 0"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search projects...">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0 0 10 0">
                    <materialDesign:PackIcon Kind="Refresh"/>
                </Button>
                <Button Command="{Binding AddNewCommand}" Style="{StaticResource MaterialDesignOutlinedButton}">
                    <materialDesign:PackIcon Kind="Plus"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Project List -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding FilteredProjects}" SelectedItem="{Binding SelectedProject}"
                      AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource MaterialDesignDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="Auto"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding ProjectCategory.Name}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Project Form -->
            <Border Grid.Column="2" Padding="15" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Project Details" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0 0 0 15"/>

                    <TextBox Text="{Binding SelectedProject.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Project name" Margin="0 0 0 10"/>
                    <TextBlock Text="{Binding SelectedProject.ErrorCollection[SelectedProject.Name]}" Foreground="Red" Margin="0 -10 0 10"/>

                    <TextBox Text="{Binding SelectedProject.Details, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Details" Margin="0 0 0 10"/>
                    <TextBlock Text="{Binding SelectedProject.ErrorCollection[SelectedProject.Details]}" Foreground="Red" Margin="0 -10 0 10"/>

                    <TextBox Text="{Binding SelectedProject.Price, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Price" Margin="0 0 0 10"/>
                    <TextBlock Text="{Binding SelectedProject.ErrorCollection[SelectedProject.Price]}" Foreground="Red" Margin="0 -10 0 10"/>

                    <ComboBox ItemsSource="{Binding ProjectCategories}" 
                              SelectedValue="{Binding SelectedProject.ProjectCategoryId, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              SelectedValuePath="Id" DisplayMemberPath="Name"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="Category" Margin="0 0 0 15"/>
                    <TextBlock Text="{Binding SelectedProject.ErrorCollection[SelectedProject.ProjectCategoryId]}" Foreground="Red" Margin="0 -10 0 10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0 0 10 0">
                            <materialDesign:PackIcon Kind="ContentSave"/>
                        </Button>
                        <Button Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" Style="{StaticResource MaterialDesignOutlinedButton}">
                            <materialDesign:PackIcon Kind="Delete"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

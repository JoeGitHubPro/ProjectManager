<UserControl x:Class="ProjectManager.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ProjectManager.Views"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- Project List -->
        <DataGrid ItemsSource="{Binding Projects}"
                  SelectedItem="{Binding SelectedProject}"
                  AutoGenerateColumns="False"
                  Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" />
                <DataGridTextColumn Header="Price" Binding="{Binding Price}" />
                <DataGridTextColumn Header="Category" Binding="{Binding ProjectCategory.Name}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Form Controls -->
        <StackPanel Grid.Column="1" Margin="10" VerticalAlignment="Top">
            <TextBlock Text="Name" />
            <TextBox Text="{Binding SelectedProject.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="Details" />
            <TextBox Text="{Binding SelectedProject.Details, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="Price" />
            <TextBox Text="{Binding SelectedProject.Price, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="Project Category" />
            <ComboBox ItemsSource="{Binding ProjectCategories}"
                      SelectedValue="{Binding SelectedProject.ProjectCategoryId, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Id"
                      DisplayMemberPath="Name"
                      Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Add" Command="{Binding AddCommand}" Margin="5" Width="60"/>
                <Button Content="Update" Command="{Binding UpdateCommand}" Margin="5" Width="60"/>
                <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="5" Width="60"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

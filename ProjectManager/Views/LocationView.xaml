<UserControl x:Class="ProjectManager.Views.LocationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ProjectManager.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+R" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search & Buttons -->
        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
            <Label>Search by name...</Label>
            <TextBox Width="200" Margin="0 0 10 0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Search" Command="{Binding SearchCommand}" Margin="0 0 10 0"/>
            <Button Content="Add New" Command="{Binding AddNewCommand}" Margin="0 0 10 0"/>
            <Button Content="Edit" Command="{Binding EditCommand}" IsEnabled="{Binding CanEditOrDelete}" Margin="0 0 10 0"/>
            <Button Content="Delete" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanEditOrDelete}" />
        </StackPanel>

        <!-- Data Grid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding FilteredLocations}"
                  SelectedItem="{Binding SelectedLocation}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0 0 0 10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Form Panel -->
        <Border Grid.Row="2"
                Background="#FFEFEFEF"
                Padding="10"
                CornerRadius="5"
                Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Vertical" >
                <TextBlock Text="Location Details" FontWeight="Bold" FontSize="14" Margin="0 0 0 10"/>

                <StackPanel Orientation="Horizontal" Margin="0 5">
                    <TextBlock Width="100" Text="Name:" VerticalAlignment="Center"/>
                    <TextBox Width="300" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock Foreground="Red" FontSize="11" Margin="100 0 0 5"
                           Text="{Binding ErrorCollection[Name]}" />

                <StackPanel Orientation="Horizontal" Margin="0 5">
                    <TextBlock Width="100" Text="Description:" VerticalAlignment="Top"/>
                    <TextBox Width="300" AcceptsReturn="True"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- Form Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
                    <Button Content="Save" Command="{Binding SaveCommand}" Margin="0 0 10 0" />
                    <Button Content="Clear" Command="{Binding ClearCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

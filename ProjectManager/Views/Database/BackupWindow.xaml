<Window x:Class="ProjectManager.Views.Database.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:materialDesignIcons="http://materialdesigninxaml.net/winfx/xaml/shared"
        FlowDirection="LeftToRight" 
    Title="Database Backup"
    Language="en-US"
    Width="420"
        MinHeight="220" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF2D2D30" 
        BorderBrush="Black"
        BorderThickness="2"
        WindowStyle="None"
        SizeToContent="Height">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Close Button -->
        <Button x:Name="CloseButton"
                Content="✖"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{StaticResource DarkBrush}"
                ToolTip="Close"     
            Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                HorizontalAlignment="Right"
            VerticalAlignment="Top"
                Padding="5"
                Margin="10"
                Command="{Binding CloseCommand}" />

            <!-- Backup Icon -->
            <materialDesign:PackIcon Kind="Database" 
                                 Width="50" Height="50" 
                                 Foreground="{StaticResource SecondaryBrush}" 
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Margin="0,15,0,10"/>

            <!-- Message -->
            <TextBlock x:Name="BackupMessageTextBlock" 
                   Grid.Row="1"
                   Text="Safely backup and restore the database."
                   Foreground="{StaticResource PrimaryBrush}" 
                   FontSize="16" 
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="20"
                   MinHeight="50" />

        <!-- Action Buttons -->
        <Border Grid.Row="2" 
                Background="{StaticResource DarkBrush}" 
                Padding="15">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center">
                <Button x:Name="BackupButton" 
                        Content="Backup"          
                        Background="{StaticResource BackgroundBrush}" 
                        Foreground="{StaticResource PrimaryBrush}"
                        FontSize="16"
                        FontWeight="Bold"
                        Padding="15,10"
                        Margin="0,0,10,0"
                        Height="40"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding BackupDatabaseCommand}"/>

                <Button x:Name="RestoreButton" 
                        Content="Restore Backup" 
                        Background="{StaticResource SecondaryBrush}" 
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        Padding="15,10"
                        Height="40"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding RestoreDatabaseCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
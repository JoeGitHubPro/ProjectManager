<UserControl x:Class="ProjectManager.Views.CapitalManagement.BusinessBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ProjectManager.Views.CapitalManagement"
             xmlns:viewModels="clr-namespace:ProjectManager.ViewModels.CapitalManagement"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- DataGridRow Coloring -->
        <Style TargetType="DataGridRow" x:Key="CashFlowRowStyle">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="Income">
                    <Setter Property="Background" Value="LightGreen"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Expense">
                    <Setter Property="Background" Value="LightCoral"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- SUMMARY SECTION -->
        <Grid Grid.Row="0" Margin="0 0 0 20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical" Grid.Column="0">
                <TextBlock Text="Business Summary" FontSize="20" FontWeight="Bold" Margin="0 0 0 10"/>

                <StackPanel Orientation="Horizontal">
                    <!-- Cash on Hand -->
                    <Border BorderBrush="LightGray" BorderThickness="0 0 1 0" Padding="10 5">
                        <StackPanel>
                            <TextBlock Text="Cash on Hand:" FontWeight="Bold" Foreground="DarkSlateGray"/>
                            <TextBlock Text="{Binding BusinessBalance.CashOnHand}" FontSize="14" Foreground="Blue" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Net Balance -->
                    <Border BorderBrush="LightGray" BorderThickness="0 0 1 0" Padding="10 5">
                        <StackPanel>
                            <TextBlock Text="Net Balance:" FontWeight="Bold" Foreground="DarkSlateGray"/>
                            <TextBlock Text="{Binding BusinessBalance.NetBusinessBalance, StringFormat=C}"
           FontSize="14"
           FontWeight="SemiBold"
           Foreground="{Binding BusinessBalance.NetBusinessBalance, Converter={StaticResource NetBalanceToBrushConverter}}"/>

                        </StackPanel>
                    </Border>

                    <!-- Emergency Reserve -->
                    <Border Padding="10 5">
                        <StackPanel>
                            <TextBlock Text="Emergency Reserve:" FontWeight="Bold" Foreground="DarkSlateGray"/>
                            <TextBlock Text="{Binding BusinessBalance.EmergencyReserve}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Refresh Button -->
            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshBalanceCommand}"
                    Width="100"
                    Height="30"
                    Margin="0 0 10 0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"/>
        </Grid>

        <!-- MAIN CONTENT -->
        <TabControl Grid.Row="1">
            <!-- Cash Flows Tab -->
            <TabItem Header="Cash Flows">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding CashFlows}"
                              AutoGenerateColumns="False"
                              RowStyle="{StaticResource CashFlowRowStyle}"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Margin="0 10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat=d}"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount}"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10">
                        <Button Content="Add Income" Command="{Binding ShowIncomeFormCommand}" Margin="5"/>
                        <Button Content="Add Expense" Command="{Binding ShowExpenseFormCommand}" Margin="5"/>
                    </StackPanel>

                    <!-- Income Form -->
                    <StackPanel Grid.Row="2"
                                Visibility="{Binding IsIncomeFormVisible, Converter={StaticResource BoolToVis}}"
                                Margin="10">
                        <TextBlock Text="Income Amount"/>
                        <TextBox Text="{Binding NewIncomeAmount}"/>
                        <TextBlock Text="Description"/>
                        <TextBox Text="{Binding NewIncomeDescription}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
                            <Button Content="Save" Command="{Binding SaveIncomeCommand}" Margin="5"/>
                            <Button Content="Cancel" Command="{Binding CancelFormCommand}" Margin="5"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Expense Form -->
                    <StackPanel Grid.Row="3"
                                Visibility="{Binding IsExpenseFormVisible, Converter={StaticResource BoolToVis}}"
                                Margin="10">
                        <TextBlock Text="Expense Amount"/>
                        <TextBox Text="{Binding NewExpenseAmount}"/>
                        <TextBlock Text="Description"/>
                        <TextBox Text="{Binding NewExpenseDescription}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
                            <Button Content="Save" Command="{Binding SaveExpenseCommand}" Margin="5"/>
                            <Button Content="Cancel" Command="{Binding CancelFormCommand}" Margin="5"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Loans Tab -->
            <TabItem Header="Loans">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Loans}"
                              SelectedItem="{Binding SelectedLoan}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Margin="10">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Lender" Binding="{Binding LenderName}"/>
                            <DataGridTextColumn Header="Amount Loaned" Binding="{Binding AmountLoaned}"/>
                            <DataGridTextColumn Header="Outstanding" Binding="{Binding OutstandingBalance}"/>
                            <DataGridTextColumn Header="Loan Date" Binding="{Binding LoanDate, StringFormat=d}"/>
                            <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=d}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10">
                        <Button Content="Add Loan" Command="{Binding ShowLoanFormCommand}" Margin="5"/>
                        <Button Content="Mark as Repaid" Command="{Binding MarkAsRepaidCommand}" Margin="5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Visibility="{Binding IsLoanFormVisible, Converter={StaticResource BoolToVis}}"
                                Margin="10">
                        <TextBlock Text="Loan Amount"/>
                        <TextBox Text="{Binding NewLoanAmount}"/>
                        <TextBlock Text="Lender"/>
                        <ComboBox ItemsSource="{Binding Users}"
                                  DisplayMemberPath="UserName"
                                  SelectedItem="{Binding SelectedUser}"/>
                        <TextBlock Text="Payback Date"/>
                        <DatePicker SelectedDate="{Binding NewLoanPaybackDate}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
                            <Button Content="Save" Command="{Binding SaveLoanCommand}" Margin="5"/>
                            <Button Content="Cancel" Command="{Binding CancelFormCommand}" Margin="5"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Emergency Reserve Tab -->
            <TabItem Header="Emergency Reserve">
                <StackPanel Margin="20">
                    <TextBlock Text="Adjust Emergency Reserve" FontWeight="Bold"/>
                    <TextBlock Text="Amount:"/>
                    <TextBox Text="{Binding EmergencyReserveAmount}"/>
                    <StackPanel Orientation="Horizontal" Margin="10 0">
                        <Button Content="Add Reserve" Command="{Binding AddReserveCommand}" Margin="5"/>
                        <Button Content="Release Reserve" Command="{Binding ReleaseReserveCommand}" Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

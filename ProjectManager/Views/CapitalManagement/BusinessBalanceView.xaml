<UserControl x:Class="ProjectManager.Views.CapitalManagement.BusinessBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ProjectManager.Views.CapitalManagement"
             xmlns:viewModels="clr-namespace:ProjectManager.ViewModels.CapitalManagement"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- DataGridRow Coloring -->
        <Style TargetType="DataGridRow" x:Key="CashFlowRowStyle">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="Income">
                    <Setter Property="Background" Value="LightGreen"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Expense">
                    <Setter Property="Background" Value="LightCoral"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- SUMMARY SECTION -->
        <Grid Grid.Row="0" Margin="0 0 0 20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical" Grid.Column="0">
                <TextBlock Text="Business Summary" FontSize="22" FontWeight="Bold" Margin="0 0 0 10"/>

                <StackPanel Orientation="Horizontal">
                    <!-- Cash on Hand -->
                    <Border BorderBrush="LightGray" BorderThickness="0 0 1 0" Padding="12 8">
                        <StackPanel>
                            <TextBlock Text="Cash on Hand:" FontWeight="Bold" Foreground="DarkSlateGray"/>
                            <TextBlock Text="{Binding BusinessBalance.CashOnHand}" FontSize="14" Foreground="DodgerBlue" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Net Balance -->
                    <Border BorderBrush="LightGray" BorderThickness="0 0 1 0" Padding="12 8">
                        <StackPanel>
                            <TextBlock Text="Net Balance:" FontWeight="Bold" Foreground="DarkSlateGray"/>
                            <TextBlock Text="{Binding BusinessBalance.NetBusinessBalance, StringFormat=C}" 
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{Binding BusinessBalance.NetBusinessBalance, Converter={StaticResource NetBalanceToBrushConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Emergency Reserve -->
                    <Border Padding="12 8">
                        <StackPanel>
                            <TextBlock Text="Emergency Reserve:" FontWeight="Bold" Foreground="DarkSlateGray"/>
                            <TextBlock Text="{Binding BusinessBalance.EmergencyReserve}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Refresh Button -->
            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshBalanceCommand}"
                    Width="100"
                    Height="35"
                    Margin="0 0 10 0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignFlatButton}"/>
        </Grid>

        <!-- MAIN CONTENT -->
        <TabControl Grid.Row="1" Margin="10">
            <!-- Cash Flows Tab -->
            <TabItem Header="Cash Flows">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- For buttons -->
                        <RowDefinition Height="Auto"/>
                        <!-- For Income Form -->
                        <RowDefinition Height="Auto"/>
                        <!-- For Expense Form -->
                        <RowDefinition Height="*"/>
                        <!-- For DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Buttons Row -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0 10">
                        <Button Content="Add Income" Command="{Binding ShowIncomeFormCommand}" 
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
                        <Button Content="Add Expense" Command="{Binding ShowExpenseFormCommand}" 
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
                    </StackPanel>

                    <!-- Income Form -->
                    <StackPanel Grid.Row="1"
                   Visibility="{Binding IsIncomeFormVisible, Converter={StaticResource BoolToVis}}"
                   Margin="10">
                        <TextBlock Text="Income Amount" />
                        <TextBox Text="{Binding NewIncomeAmount}" Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        <TextBlock Text="Description" />
                        <TextBox Text="{Binding NewIncomeDescription}" Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
                            <Button Content="Save" Command="{Binding SaveIncomeCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
                            <Button Content="Cancel" Command="{Binding CancelFormCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Expense Form -->
                    <StackPanel Grid.Row="2"
                   Visibility="{Binding IsExpenseFormVisible, Converter={StaticResource BoolToVis}}"
                   Margin="10">
                        <TextBlock Text="Expense Amount" />
                        <TextBox Text="{Binding NewExpenseAmount}" Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        <TextBlock Text="Description" />
                        <TextBox Text="{Binding NewExpenseDescription}" Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
                            <Button Content="Save" Command="{Binding SaveExpenseCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
                            <Button Content="Cancel" Command="{Binding CancelFormCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- DataGrid Row -->
                    <DataGrid Grid.Row="3"
                 ItemsSource="{Binding CashFlows}"
                 AutoGenerateColumns="False"
                 RowStyle="{StaticResource CashFlowRowStyle}"
                 CanUserAddRows="False"
                 IsReadOnly="True"
                 Margin="0 10"
                 Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat=d}" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Loans Tab -->
            <TabItem Header="Loans">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- For buttons -->
                        <RowDefinition Height="Auto"/>
                        <!-- For Loan Form -->
                        <RowDefinition Height="*"/>
                        <!-- For DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Buttons Row -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0 10">
                        <Button Content="Add Loan" Command="{Binding ShowLoanFormCommand}" 
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
                        <Button Content="Mark as Repaid" Command="{Binding MarkAsRepaidCommand}" 
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
                    </StackPanel>

                    <!-- Loan Form -->
                    <StackPanel Grid.Row="1"
                    Visibility="{Binding IsLoanFormVisible, Converter={StaticResource BoolToVis}}"
                    Margin="10">
                        <TextBlock Text="Loan Amount" />
                        <TextBox Text="{Binding NewLoanAmount}" Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        <TextBlock Text="Lender" />
                        <ComboBox ItemsSource="{Binding Users}" 
                      DisplayMemberPath="UserName" 
                      SelectedItem="{Binding SelectedUser}" 
                      Style="{StaticResource MaterialDesignComboBox}" />
                        <TextBlock Text="Payback Date" />
                        <DatePicker SelectedDate="{Binding NewLoanPaybackDate}" 
                        Style="{StaticResource MaterialDesignDatePicker}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
                            <Button Content="Save" Command="{Binding SaveLoanCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
                            <Button Content="Cancel" Command="{Binding CancelFormCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- DataGrid Row -->
                    <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Loans}"
                  SelectedItem="{Binding SelectedLoan}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Margin="10"
                  Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Lender" Binding="{Binding LenderName}" />
                            <DataGridTextColumn Header="Amount Loaned" Binding="{Binding AmountLoaned}" />
                            <DataGridTextColumn Header="Outstanding" Binding="{Binding OutstandingBalance}" />
                            <DataGridTextColumn Header="Loan Date" Binding="{Binding LoanDate, StringFormat=d}" />
                            <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=d}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Emergency Reserve Tab -->
            <TabItem Header="Emergency Reserve">
                <StackPanel Margin="20">
                    <TextBlock Text="Adjust Emergency Reserve" FontWeight="Bold"/>
                    <TextBlock Text="Amount:"/>
                    <TextBox Text="{Binding EmergencyReserveAmount}" Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    <StackPanel Orientation="Horizontal" Margin="10 0">
                        <Button Content="Add Reserve" Command="{Binding AddReserveCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
                        <Button Content="Release Reserve" Command="{Binding ReleaseReserveCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

<UserControl x:Class="ProjectManager.Views.ProjectOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <TextBox Width="250"
                     Margin="0 0 10 0"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search orders...">
            </TextBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding ReloadPageCommand}" Style="{StaticResource OutlinedButtonStyle}" Margin="0,0,10,0">
                    <materialDesign:PackIcon Kind="Reload" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}">
                    <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding ProjectOrders}"
                      SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Style="{StaticResource MaterialDesignDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Project" Binding="{Binding Project.Name}" Width="*" />
                    <DataGridTextColumn Header="Discount" Binding="{Binding Discount, StringFormat={}{0}%}" Width="Auto"/>
                    <DataGridTextColumn Header="Installation Info" Binding="{Binding InstallationSystemInfo}" Width="*" />
                    <DataGridTextColumn Header="Sold Date" Binding="{Binding SoldDate, StringFormat=d}" Width="Auto"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                    <DataGridTextColumn Header="Consumer Phone" Binding="{Binding Consumer.Phone}" Width="Auto"/>
                    <DataGridTextColumn Header="Total Price" Binding="{Binding TotalPrice, StringFormat=C}" Width="Auto"/>
                    <DataGridTextColumn Header="Folder Serial" Binding="{Binding FolderSerial}" Width="*"/>

                    <!-- Locate and Update buttons -->
                    <DataGridTemplateColumn Header="Actions" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Locate Button -->
                                    <Button Command="{Binding DataContext.LocateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource OutlinedButtonStyle}"
                            Margin="0,5,5,0">
                                        <materialDesign:PackIcon Kind="FolderSearchOutline" Width="20" Height="20"/>
                                    </Button>

                                    <!-- Update Button -->
                                <Button Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                            Style="{StaticResource OutlinedButtonStyle}"
                            Margin="0,0,0,0">
                                        <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

            </DataGrid>

            <!-- Form Panel -->
            <Border Grid.Column="2" Width="320" Padding="15" Background="White" CornerRadius="5"
                    BorderBrush="#DDD" BorderThickness="1"
                    Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
                <ScrollViewer>
                    <StackPanel>

                        <TextBlock Text="Order Details" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,15"/>

                        <Label Content="Project"/>
                        <ComboBox ItemsSource="{Binding Projects}" 
                                  DisplayMemberPath="Name" 
                                  SelectedValuePath="Id" 
                                  SelectedValue="{Binding SelectedProjectId, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource MaterialDesignComboBox}" Margin="0,0,0,10"/>

                        <Label Content="Discount (%)"/>
                        <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>

                        <Label Content="Installation Info"/>
                        <TextBox Text="{Binding InstallationSystemInfo, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>

                        <Label Content="Sold Date"/>
                        <DatePicker SelectedDate="{Binding SoldDate, UpdateSourceTrigger=PropertyChanged}" 
                                    Style="{StaticResource MaterialDesignDatePicker}" Margin="0,0,0,10"/>

                        <Label Content="Notes"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>

                        <Label Content="Consumer Phone"/>
                        <ComboBox ItemsSource="{Binding Consumers}" DisplayMemberPath="Phone" 
                                  SelectedValuePath="Id" 
                                  SelectedValue="{Binding SelectedConsumerId, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource MaterialDesignComboBox}" Margin="0,0,0,15"/>

                        <TextBlock Text="Total Price:" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="{Binding TotalPrice, StringFormat=C}" FontSize="16" Foreground="Green" Margin="0,0,0,15"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20"/>
                            </Button>

                            <Button Command="{Binding DeleteCommand}" Style="{StaticResource OutlinedButtonStyle}">
                                <materialDesign:PackIcon Kind="Delete" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

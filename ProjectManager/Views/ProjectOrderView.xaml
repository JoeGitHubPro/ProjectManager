<UserControl x:Class="ProjectManager.Views.ProjectOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:ProjectManager.Helpers">

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+R" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <TextBox x:Name="SearchTextBox"
                Width="250"
                     Margin="0 0 10 0"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search orders...">
            </TextBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding ReloadPageCommand}" 
                        Style="{StaticResource OutlinedButtonStyle}" 
                        Margin="0,0,10,0">
                    <materialDesign:PackIcon Kind="Reload" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding AddCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}">
                    <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding ProjectOrders}"
                      SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
          ScrollViewer.CanContentScroll="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Project" Binding="{Binding Project.Name}" Width="*"/>
                    <DataGridTextColumn Header="Discount" Binding="{Binding Discount, StringFormat={}{0}%}" Width="Auto"/>
                    <DataGridTextColumn Header="Commission" Binding="{Binding Commission, StringFormat={}{0}%}" Width="Auto"/>
                    <DataGridTextColumn Header="Installation Info" Binding="{Binding InstallationSystemInfo}" Width="*"/>
                    <DataGridTextColumn Header="Sold Date" Binding="{Binding SoldDate, StringFormat=d}" Width="Auto"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                    <DataGridTextColumn Header="Consumer Phone" Binding="{Binding Consumer.Phone}" Width="Auto"/>
                    <DataGridTextColumn Header="Total Price" Binding="{Binding TotalPrice, StringFormat=C}" Width="Auto"/>
                    <DataGridTextColumn Header="Folder Serial" Binding="{Binding FolderSerial}" Width="*"/>

                    <DataGridTemplateColumn Header="Actions" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.LocateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource OutlinedButtonStyle}"
                                            Margin="0,0,5,0">
                                        <materialDesign:PackIcon Kind="FolderSearchOutline" Width="20" Height="20"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource OutlinedButtonStyle}">
                                        <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Form Panel -->
            <Border Grid.Column="2" 
                    Width="320" 
                    Padding="15" 
                    FocusManager.FocusedElement="{Binding ElementName=ProjectComboBox}"
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Background="White"  
                    Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
                <ScrollViewer  VerticalScrollBarVisibility="Hidden" 
              PanningMode="VerticalOnly"
              CanContentScroll="True"
              Background="Transparent">
                    <StackPanel>
                        <TextBlock Text="Order Details" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,15"/>

                        <Label Content="Project"/>
                        <ComboBox x:Name="ProjectComboBox"
                                  ItemsSource="{Binding Projects}" 
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedProjectId, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource MaterialDesignComboBox}" 
                                  Margin="0,0,0,10"
                                  helpers:EnterKeyTraversal.IsEnabled="True"/>

                        <Label Content="Consumer"/>
                        <ComboBox ItemsSource="{Binding Consumers}" 
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedConsumerId, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource MaterialDesignComboBox}" 
                                  Margin="0,0,0,15"
                                  helpers:EnterKeyTraversal.IsEnabled="True"/>

                        <Label Content="Sold Date"/>
                        <DatePicker SelectedDate="{Binding SoldDate, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MaterialDesignDatePicker}" 
                                    Margin="0,0,0,10"
                                    helpers:EnterKeyTraversal.IsEnabled="True"/>

                        <Label Content="Discount (%)"/>
                        <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 Margin="0,0,0,10"
                                 helpers:EnterKeyTraversal.IsEnabled="True"/>
                        
                        <Label Content="Commission (%)"/>
                        <TextBox Text="{Binding Commission, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 Margin="0,0,0,10"
                                 helpers:EnterKeyTraversal.IsEnabled="True"/>


                        <Label Content="Installation Info"/>
                        <TextBox Text="{Binding InstallationSystemInfo, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 Margin="0,0,0,10"
                                 helpers:EnterKeyTraversal.IsEnabled="True"/>



                        <Label Content="Notes"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" 
                                 TextWrapping="Wrap" 
                                 Height="80"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 Margin="0,0,0,10"
                                 helpers:EnterKeyTraversal.IsEnabled="True"/>



                        <TextBlock Text="Total Price:" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="{Binding TotalPrice, StringFormat=C}" 
                                   FontSize="16" 
                                   Foreground="Green" 
                                   Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding SaveCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20"/>
                            </Button>
                            <Button Command="{Binding DeleteCommand}" 
                                    Style="{StaticResource OutlinedButtonStyle}">
                                <materialDesign:PackIcon Kind="Delete" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
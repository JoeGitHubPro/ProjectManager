<UserControl x:Class="ProjectManager.Views.ProjectOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Input Form -->
        <Border Grid.Row="0" BorderThickness="1" CornerRadius="5" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Orientation="Vertical" Grid.Column="0">
                    <TextBlock Text="Project" Margin="0,0,0,2" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Projects}" 
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedProjectId, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,10"/>

                    <TextBlock Text="Discount (%)" Margin="0,0,0,2" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Installation System Info" Margin="0,0,0,2" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding InstallationSystemInfo, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                             Margin="0,0,0,10"/>
                </StackPanel>

                <!-- Right Column -->
                <StackPanel Orientation="Vertical" Grid.Column="2">
                    <TextBlock Text="Sold Date" Margin="0,0,0,2" FontWeight="SemiBold"/>
                    <DatePicker SelectedDate="{Binding SoldDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                Margin="0,0,0,10"/>

                    <TextBlock Text="Notes" Margin="0,0,0,2" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Consumer Phone" Margin="0,0,0,2" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Consumers}" 
                              DisplayMemberPath="Phone"
                              SelectedValuePath="Phone"
                              SelectedValue="{Binding SelectedConsumerPhone, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                              Margin="0,0,0,10"/>

                    <!-- Total Price Calculation Display -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Total Price:" FontWeight="Bold" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding TotalPrice, StringFormat=C}" FontWeight="Bold" Foreground="Green"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search Panel -->
        <Border Grid.Row="2" BorderThickness="1" CornerRadius="5" Padding="10">
            <DockPanel LastChildFill="True">
                <Button Content="Reload" DockPanel.Dock="Right" Width="60" Height="30"
                        VerticalAlignment="Bottom" Command="{Binding ReloadPageCommand}" Margin="10,0,0,0"/>
                <Button Content="Refresh" DockPanel.Dock="Right" Width="60" Height="30"
                        VerticalAlignment="Bottom" Command="{Binding RefreshCommand}" Margin="10,0,0,0"/>

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Search Orders" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="5" MinWidth="200"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="4" BorderThickness="1" CornerRadius="5">
            <DataGrid ItemsSource="{Binding ProjectOrders}" SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="None"
                      HeadersVisibility="Column" ColumnHeaderHeight="30" RowHeight="30">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Project" Binding="{Binding Project.Name}" Width="*"/>
                    <DataGridTextColumn Header="Discount" Binding="{Binding Discount, StringFormat={}{0}%}" Width="Auto"/>
                    <DataGridTextColumn Header="Installation Info" Binding="{Binding InstallationSystemInfo}" Width="*"/>
                    <DataGridTextColumn Header="Sold Date" Binding="{Binding SoldDate, StringFormat=d}" Width="Auto"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                    <DataGridTextColumn Header="Consumer Phone" Binding="{Binding ConsumerPhone}" Width="Auto"/>
                    <DataGridTextColumn Header="Total Price" Binding="{Binding TotalPrice, StringFormat=C}" Width="Auto"/>
                    <DataGridTextColumn Header="Folder Serial" Binding="{Binding FolderSerial}" Width="Auto"/>

                    <DataGridTemplateColumn Header="Actions" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="📂" ToolTip="Locate"
                                        Command="{Binding DataContext.LocateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Width="30" Height="30"
                                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Add" Command="{Binding AddCommand}" Margin="5" Width="80" Height="30"/>
            <Button Content="Update" Command="{Binding UpdateCommand}" Margin="5" Width="80" Height="30"/>
            <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="5" Width="80" Height="30"/>
            <Button Content="Clear" Command="{Binding ClearCommand}" Margin="5" Width="80" Height="30"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Margin="5" Width="80" Height="30"/>
        </StackPanel>
    </Grid>
</UserControl>
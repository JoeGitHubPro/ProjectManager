<Window x:Class="ProjectManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ProjectManager.Views"
        xmlns:Identity="clr-namespace:ProjectManager.Views.Identities"
        Title="Project Manager" Height="600" Width="900" WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WhiteBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="{StaticResource WhiteBrush}" Padding="5" CornerRadius="0,0,10,10">
            <StackPanel>
                <TextBlock Text="Ice Code" 
                           Style="{StaticResource HeadingTextStyle}" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Project Manager System" 
                           Style="{StaticResource BodyTextStyle}" 
                           HorizontalAlignment="Center" 
                           Margin="0,5,0,0"/>
                <TextBlock Text="Manage your projects efficiently and easily" 
                           Style="{StaticResource BodyTextStyle}" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content (Tabs) -->
        <TabControl Grid.Row="1" Margin="10" Background="{StaticResource WhiteBrush}">
            <TabItem Header="Project Order" IsEnabled="{Binding IsProjectOrderEnabled}">
                <views:ProjectOrderView DataContext="{Binding ProjectOrderVM}" />
            </TabItem>
            <TabItem Header="Project Categories" IsEnabled="{Binding IsProjectCategoriesEnabled}">
                <views:ProjectCategoryView DataContext="{Binding ProjectCategoryVM}" />
            </TabItem>
            <TabItem Header="Projects" IsEnabled="{Binding IsProjectsEnabled}">
                <views:ProjectView DataContext="{Binding ProjectVM}" />
            </TabItem>
            <TabItem Header="Consumers" IsEnabled="{Binding IsConsumersEnabled}">
                <views:ConsumerView DataContext="{Binding ConsumerVM}"/>
            </TabItem>
            <TabItem Header="Users Management" IsEnabled="{Binding IsUsersManagementEnabled}">
                <Identity:UserManagementView DataContext="{Binding UserManagementVM}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

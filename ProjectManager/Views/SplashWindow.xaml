<Window x:Class="ProjectManager.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Manager"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        Width="500" Height="300">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title and Subtitle -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Project Manager" 
                       TextAlignment="Center"
                       Style="{StaticResource HeadingTextStyle}"
                       Margin="0,0,0,20" />

            <TextBlock Text="Manage all your projects efficiently and easily."
                       Style="{StaticResource BodyTextStyle}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Width="300" />
        </StackPanel>

        <!-- Progress Bar -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <ProgressBar Width="300"
                         Height="3"
                         BorderThickness="0"
                         IsIndeterminate="True"
                         Foreground="{StaticResource AccentBrush}"
                         Background="{StaticResource PrimaryBrush}" />
        </StackPanel>

        <!-- Footer Text (Optional: Loading...) -->
        <TextBlock Grid.Row="2"
                   Text="Loading..."
                   Style="{StaticResource BodyTextStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,10"/>
    </Grid>
</Window>

<Window x:Class="ProjectManager.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SplashScreen" 
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="{StaticResource DarkBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Height="300" 
        Width="500">

    <Window.Resources>
        <!-- 🎬 First Animation: Logo Fade-In & Move -->
        <Storyboard x:Key="LogoAnimation">
            <DoubleAnimation Storyboard.TargetName="LogoImage"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:1"/>

            <DoubleAnimation Storyboard.TargetName="LogoImage"
                             Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                             From="0" To="-30"
                             Duration="0:0:0.5"/>
        </Storyboard>

        <!-- 🎬 Second Animation: Loading Text & Progress Bar -->
        <Storyboard x:Key="LoadingAnimation">
            <DoubleAnimation Storyboard.TargetName="LoadingText"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:1"/>
            <DoubleAnimation Storyboard.TargetName="LoadingText"
                             Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                             From="0" To="-10"
                             Duration="0:0:0.5"/>

            <DoubleAnimation Storyboard.TargetName="info"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.5"/>

            <DoubleAnimation Storyboard.TargetName="info"
                             Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                             From="0" To="-10"
                             Duration="0:0:0.5"/>

            <DoubleAnimation Storyboard.TargetName="LoadingBar"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.5"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Background -->
        <Border Background="{StaticResource DarkBrush}">
            <Grid>
                <!-- Logo or Image -->
                <Image Source="/Assets/icepharmacy-icon.png" 
                       x:Name="LogoImage"
                       Width="150" 
                       Height="150"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0" 
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Image.RenderTransform>
                </Image>

                <!-- Loading Message -->
                <TextBlock x:Name="LoadingText" Text="IcePharmacy"
                   Style="{StaticResource HeadingTextStyle}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,230,0,0"
                   Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- Loading Animation (Progress Bar) -->
                <ProgressBar IsIndeterminate="True" 
                             x:Name="LoadingBar"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Width="200"
                             Height="10"
                             Margin="0,260,0,0" 
                             Background="{StaticResource WhiteBrush}" 
                             BorderBrush="{StaticResource AccentBrush}" 
                             Foreground="{StaticResource PrimaryBrush}"
                             Opacity="0">
                    <ProgressBar.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </ProgressBar.RenderTransform>
                </ProgressBar>

                <!-- Footer Info Text -->
                <TextBlock x:Name="info" Text="By: Icecode"
                   Style="{StaticResource BodyTextStyle}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="374,264,0,0"
                   Opacity="0" RenderTransformOrigin="0.495,-1.401">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>

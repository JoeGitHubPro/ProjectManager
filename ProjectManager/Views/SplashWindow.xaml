<Window x:Class="ProjectManager.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SplashScreen" 
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Height="300" 
        Width="500">


    <!-- Animation code          -->
    <Window.Resources>
        <!-- 🎬 First Animation: Logo Fade-In & Move -->
        <Storyboard x:Key="LogoAnimation">
            <DoubleAnimation Storyboard.TargetName="LogoImage"
                         Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="0:0:1"/>

            <DoubleAnimation Storyboard.TargetName="LogoImage"
                         Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                         From="0" To="-30"
                         Duration="0:0:0.5"/>
        </Storyboard>

        <!-- 🎬 Second Animation: Loading Text & Progress Bar (Starts After LogoAnimation) -->
        <Storyboard x:Key="LoadingAnimation">
            <DoubleAnimation Storyboard.TargetName="LoadingText"
                         Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="0:0:1"/>
            <DoubleAnimation Storyboard.TargetName="LoadingText"
                         Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                         From="0" To="-10"
                         Duration="0:0:0.5"/>


            <DoubleAnimation Storyboard.TargetName="info"
                         Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="0:0:0.5"/>

            <DoubleAnimation Storyboard.TargetName="info"
                         Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                         From="0" To="-10"
                         Duration="0:0:0.5"/>

            <DoubleAnimation Storyboard.TargetName="LoadingBar"
                         Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="0:0:0.5"/>

            
        </Storyboard>
    </Window.Resources>



    <Grid>
        <!-- Background -->
        <Border Background="{StaticResource BackgroundBrush}">
            <Grid>
                <!-- Logo or Image -->
                <Image Source="/Assets/icepharmacy-icon.png" 
                       x:Name="LogoImage"
                       Width="150" 
                       Height="150"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0" 
                       RenderTransformOrigin="0.5,0.5"
                       >

                    <Image.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Image.RenderTransform>
                </Image>

                <!-- Loading Message -->
                <TextBlock x:Name="LoadingText" Text="IcePharmacy"
                   Foreground="{StaticResource PrimaryBrush}" 
                   FontSize="13" 
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="79,262,0,0"
                   Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </TextBlock.RenderTransform>


                </TextBlock>
                <!-- Loading Animation (Progress Bar) -->
                <ProgressBar IsIndeterminate="True" 
                     x:Name="LoadingBar"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Width="200"
                     Height="10"
                     Margin="0,230,0,0" 
                     Background="{StaticResource ForegroundBrush }" 
                     BorderBrush="{StaticResource DarkAccentBrush }" 
                     Foreground="{StaticResource PrimaryBrush}"
                     Opacity="0"
                             >
                    <ProgressBar.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </ProgressBar.RenderTransform>
                </ProgressBar>
                <TextBlock x:Name="info" Text="By: Icecode"
                   Foreground="{StaticResource PrimaryBrush}" 
                   FontSize="13" 
                   FontFamily="InterFont"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="374,264,0,0"
                   Opacity="0" RenderTransformOrigin="0.495,-1.401">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </TextBlock.RenderTransform>

                    
                </TextBlock>

            </Grid>
        </Border>
    </Grid>
</Window>
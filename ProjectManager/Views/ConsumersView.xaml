<UserControl x:Class="ProjectManager.Views.ConsumerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search and Action Bar -->
        <Border Grid.Row="0" 
                BorderThickness="0 0 0 1" Padding="0 0 0 5" Margin="0 0 0 10">
            <DockPanel>
                <!-- Search Box -->
                <TextBox DockPanel.Dock="Left" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Search consumers..."
                         Width="250" Margin="0 0 10 0"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Action Buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding RefreshCommand}"
            Style="{StaticResource MaterialDesignOutlinedButton}"
            Margin="0 0 10 0"
            Width="100">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0 0 5 0"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddNewCommand}"
            Style="{StaticResource MaterialDesignOutlinedButton}"
            Width="100">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0 0 5 0"/>
                            <TextBlock Text="Add New" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="1"
                BorderThickness="1" CornerRadius="4" Padding="1">
            <DataGrid ItemsSource="{Binding FilteredConsumers}"
                      SelectedItem="{Binding SelectedConsumer}"
                      AutoGenerateColumns="False"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      GridLinesVisibility="None"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      ColumnHeaderHeight="35"
                      RowHeight="35"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="*"/>
                    <DataGridTextColumn Header="Commercial Register" Binding="{Binding CommercialRegisterNo}" Width="*"/>
                    <DataGridTemplateColumn Header="Actions" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✏️" ToolTip="Edit"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="30" Height="30" 
                                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Form Controls -->
        <Border Grid.Row="2"
                BorderThickness="1" CornerRadius="4" Padding="15" Margin="0 10 0 0">
            <StackPanel>
                <TextBlock Text="Consumer Details" 
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Margin="0 0 0 15"/>

                <!-- Phone Field -->
                <TextBox materialDesign:HintAssist.Hint="Phone number"
                         Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0 0 0 10"/>
                <TextBlock Text="{Binding ErrorCollection[Phone]}"
                           Foreground="Red" Margin="0 -10 0 10" TextWrapping="Wrap"/>

                <!-- Commercial Register Field -->
                <TextBox materialDesign:HintAssist.Hint="Commercial Register Number"
                         Text="{Binding CommercialRegisterNo, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0 0 0 15"/>
                <TextBlock Text="{Binding ErrorCollection[CommercialRegisterNo]}"
                           Foreground="Red" Margin="0 -15 0 10" TextWrapping="Wrap"/>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding SaveCommand}"
        Style="{StaticResource MaterialDesignRaisedButton}"
        Margin="0 0 10 0"
        Width="80">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0 0 5 0"/>
                            <TextBlock Text="Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DeleteCommand}"
        Style="{StaticResource MaterialDesignOutlinedButton}"
        Width="80"
        IsEnabled="{Binding CanDelete}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Margin="0 0 5 0"/>
                            <TextBlock Text="Delete" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ClearCommand}"
        Style="{StaticResource MaterialDesignOutlinedButton}"
        Width="80"
        Margin="10 0 0 0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0 0 5 0"/>
                            <TextBlock Text="Clear" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
<UserControl x:Class="ProjectManager.Views.ConsumerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">   

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar: Search and Actions -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search -->
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search consumers..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,10,0"/>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,5,0" ToolTip="Refresh">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding AddNewCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,5,0" ToolTip="Add New Consumer">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" Margin="0,0,5,0"/>
                        <TextBlock Text="Add"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,5,0" ToolTip="Save">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,5,0"/>
                        <TextBlock Text="Save"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteCommand}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanDelete}" ToolTip="Delete">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Margin="0,0,5,0"/>
                        <TextBlock Text="Delete"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Area: DataGrid and Form -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid for Consumers -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding FilteredConsumers}"
                      SelectedItem="{Binding SelectedConsumer, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Margin="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="*" />
                    <DataGridTextColumn Header="Whatsapp" Binding="{Binding Whatsapp}" Width="*" />
                    <DataGridTextColumn Header="Facebook" Binding="{Binding Facebook}" Width="*" />
                    <DataGridTextColumn Header="Instagram" Binding="{Binding Instagram}" Width="*" />
                    <DataGridTextColumn Header="TikTok" Binding="{Binding TikTok}" Width="*" />
                    <DataGridTextColumn Header="X" Binding="{Binding X}" Width="*" />
                    <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="*" />
                    <DataGridTextColumn Header="Commercial No." Binding="{Binding CommercialRegisterNo}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Form for Editing / Adding -->
            <ScrollViewer Grid.Column="1" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0" VerticalAlignment="Top">
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Name"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,5"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Phone"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,5"/>
                    <TextBox Text="{Binding Whatsapp, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Whatsapp"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,5"/>
                    <TextBox Text="{Binding Facebook, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Facebook"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,5"/>
                    <TextBox Text="{Binding Instagram, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Instagram"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,5"/>
                    <TextBox Text="{Binding TikTok, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="TikTok"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,5"/>
                    <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="X"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,5"/>
                    <TextBox Text="{Binding Site, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Website"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,5"/>
                    <TextBox Text="{Binding CommercialRegisterNo, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Commercial Register Number"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,5"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>

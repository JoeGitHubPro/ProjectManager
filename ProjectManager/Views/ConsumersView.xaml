<UserControl x:Class="ProjectManager.Views.ConsumerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:ProjectManager.Converters"
             xmlns:helpers="clr-namespace:ProjectManager.Helpers">

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+R" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False" VerticalAlignment="Center">
            <!-- Search Box -->
            <TextBox x:Name="SearchTextBox" Width="250"
             Margin="0 0 10 0"
             Style="{StaticResource MaterialDesignOutlinedTextBox}"
             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
             materialDesign:HintAssist.Hint="Search consumers...">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <!-- Location Filter ComboBox -->
            <ComboBox Width="150"
              ItemsSource="{Binding Locations}"
              SelectedItem="{Binding SelectedLocationFilter}"
              DisplayMemberPath="Name"
              Style="{StaticResource MaterialDesignOutlinedComboBox}"
              Margin="0 0 10 0"
              materialDesign:HintAssist.Hint="Filter by Location"/>
            
            <ComboBox Width="150"
              ItemsSource="{Binding Sellers}"
              SelectedItem="{Binding SelectedSellerFilter}"
              DisplayMemberPath="UserName"
              Style="{StaticResource MaterialDesignOutlinedComboBox}"
              Margin="0 0 10 0"
              materialDesign:HintAssist.Hint="Responsible Seller"/>
          
            <ComboBox Width="150"
              ItemsSource="{Binding ConsumerStatuses}"
              SelectedItem="{Binding SelectedStatus}"
              Style="{StaticResource MaterialDesignOutlinedComboBox}"
              Margin="0 0 10 0"
              materialDesign:HintAssist.Hint="Filter by Status"/>

            <!-- Range Filter Fields -->
            <TextBox Width="60"
             Text="{Binding RangeStart, UpdateSourceTrigger=PropertyChanged}"
             Style="{StaticResource MaterialDesignOutlinedTextBox}"
             Margin="0 0 5 0"
             materialDesign:HintAssist.Hint="From"/>
            <TextBox Width="60"
             Text="{Binding RangeEnd, UpdateSourceTrigger=PropertyChanged}"
             Style="{StaticResource MaterialDesignOutlinedTextBox}"
             Margin="0 0 10 0"
             materialDesign:HintAssist.Hint="To"/>

            <Button Command="{Binding ApplyRangeFilterCommand}" Style="{StaticResource OutlinedButtonStyle}" Margin="0,0,10,0">
                <materialDesign:PackIcon Kind="Filter" Width="20" Height="20"/>
            </Button>

            <!-- Right-aligned toolbar actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource OutlinedButtonStyle}" Margin="0,0,10,0">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding ReadExcelCommand}" Style="{StaticResource OutlinedButtonStyle}" Margin="0,0,10,0">
                    <materialDesign:PackIcon Kind="FileExcel" Foreground="ForestGreen" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding AddNewCommand}" Style="{StaticResource OutlinedButtonStyle}">
                    <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"/>
                </Button>               
                <Button Command="{Binding AssignCommand}" Style="{StaticResource OutlinedButtonStyle}">
                    <materialDesign:PackIcon Kind="Arrow" Width="20" Height="20"/>
                </Button>
            </StackPanel>
        </DockPanel>


        <!-- Main Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Consumer List -->
            <DataGrid Grid.Column="0"
             RowStyle="{StaticResource ConsumerRowStyle}"
          ItemsSource="{Binding FilteredConsumers}"
          SelectedItem="{Binding SelectedConsumer, Mode=TwoWay}"
          SelectionMode="Extended"
          SelectionUnit="FullRow"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          Style="{StaticResource MaterialDesignDataGrid}"
          EnableRowVirtualization="True"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          converters:DataGridSelectedItemsConverter.SelectedItems="{Binding SelectedConsumers, Mode=TwoWay}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" 
                            Binding="{Binding Id}" 
                            IsReadOnly="True" />

                    <DataGridTextColumn Header="Name" 
                            Binding="{Binding Name}" />

                    <DataGridTextColumn Header="Description" 
                            Binding="{Binding Description}" />

                    <DataGridTextColumn Header="Phone" 
                            Binding="{Binding Phone}" />

                    <!-- Assuming Location is not null. Otherwise use a converter or safe navigation -->
                    <DataGridTextColumn Header="Location" 
                            Binding="{Binding Location.Name}" />

                    <DataGridTemplateColumn Header="Location Map">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                <Hyperlink NavigateUri="{Binding LocationMap}" TargetName="_blank">
                    <TextBlock Text="{Binding LocationMap}" />
                </Hyperlink>
            </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>




                    <!-- Assuming ResponsibleSeller is not null -->
                    <DataGridTextColumn Header="Seller" 
                            Binding="{Binding ResponsibleSeller.UserName}" />

                    <DataGridTextColumn Header="CRN" 
                            Binding="{Binding CommercialRegisterNo}" />
                    
                    <DataGridTextColumn Header="Notes" 
                            Binding="{Binding Notes}" />

                    <DataGridTextColumn Header="Status" Width="*"
                            Binding="{Binding Status}" />

                    <DataGridTemplateColumn Header="Actions" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource OutlinedButtonStyle}">
                                    <materialDesign:PackIcon Kind="Pencil"
                                                 Width="18"
                                                 Height="18"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>


            <!-- Form Panel -->
            <Border Grid.Column="2"
                    Width="400"
                    Padding="15"
                    Background="White"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Consumer Details" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>

                        <!-- Fields -->
                        <Label Content="Name"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>

                        <Label Content="Phone"/>
                        <TextBox Text="{Binding Phone}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>

                        <Label Content="CRN"/>
                        <TextBox Text="{Binding CommercialRegisterNo, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>

                        <Label Content="Location"/>
                        <ComboBox ItemsSource="{Binding Locations}" 
                                  SelectedItem="{Binding SelectedLocation}" 
                                  DisplayMemberPath="Name" 
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,10"/>

                        <Label Content="Location Map"/>
                        <TextBox Text="{Binding LocationMap}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>

                        <Label Content="Seller"/>
                        <ComboBox ItemsSource="{Binding Sellers}" 
                                  SelectedItem="{Binding SelectedSeller}" 
                                  DisplayMemberPath="UserName" 
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,10"/>

                        <Label Content="Status"/>
                        <ComboBox ItemsSource="{Binding ConsumerStatuses}" 
                                  SelectedItem="{Binding ConsumerStatus}" 
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,10"/>

                        <Label Content="Description"/>
                        <TextBox Text="{Binding Description}" AcceptsReturn="True" Height="60"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>

                        <Label Content="Whatsapp"/>
                        <TextBox Text="{Binding Whatsapp}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>

                        <Label Content="Facebook"/>
                        <TextBox Text="{Binding Facebook}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>

                        <Label Content="Instagram"/>
                        <TextBox Text="{Binding Instagram}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>

                        <Label Content="TikTok"/>
                        <TextBox Text="{Binding TikTok}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>

                        <Label Content="X (Twitter)"/>
                        <TextBox Text="{Binding X}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>

                        <Label Content="Website"/>
                        <TextBox Text="{Binding Site}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>

                        <Label Content="Notes"/>
                        <TextBox Text="{Binding Notes}" AcceptsReturn="True" Height="60"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,20"/>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20"/>
                            </Button>
                            <Button Command="{Binding DeleteCommand}" 
                                    IsEnabled="{Binding CanDelete}" 
                                    Style="{StaticResource OutlinedButtonStyle}">
                                <materialDesign:PackIcon Kind="Delete" Width="20" Height="20"/>
                            </Button>
                            <Button Command="{Binding ClearCommand}" Style="{StaticResource OutlinedButtonStyle}" Margin="10,0,0,0">
                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

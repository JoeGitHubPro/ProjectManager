<Window x:Class="ProjectManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="450" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF"
        WindowStyle="None">
    <Border Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Center" BorderBrush="#DDD" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Text="Login" FontSize="24" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" />

            <!-- Spacer -->
            <Grid Grid.Row="1"/>

            <!-- Username -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="Username" Foreground="#666" FontSize="14" Margin="5,0,0,2"/>
                <TextBox x:Name="UsernameTextBox" 
                         Height="35" 
                         Padding="10"
                         FontSize="14"
                         Background="#F9F9F9"
                         BorderBrush="#CCC"
                         BorderThickness="1"/>
            </StackPanel>

            <!-- Password -->
            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                <TextBlock Text="Password" Foreground="#666" FontSize="14" Margin="5,0,0,2"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="35"
                             Padding="10"
                             FontSize="14"
                             Background="#F9F9F9"
                             BorderBrush="#CCC"
                             BorderThickness="1"/>
            </StackPanel>

            <!-- Login Button -->
            <Button Grid.Row="6" Content="Login"
                    Margin="0,20,0,0"
                    Height="40"
                    Background="#0078D7"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="LoginButton_Click"/>

        </Grid>
    </Border>
</Window>

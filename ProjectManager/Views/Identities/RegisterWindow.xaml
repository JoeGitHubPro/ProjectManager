<Window x:Class="ProjectManager.Views.Identities.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:ProjectManager.Helpers"
        Title="Register"
        Language="en-US" Height="630" Width="870"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        Background="LightGray">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding RegisterCommand}" />
        <KeyBinding Gesture="ESC" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Right Side: Brand Section -->
        <Border Grid.Column="1" Background="Gray">
            <Grid>
                <Image Source="/Assets/icepharmacy-horizontal.png"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" Height="80" Width="284" Opacity="0.7" />
                <Image Source="/Assets/snowflakewhite.png"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="335,0,0,540" Height="118" Width="134" Opacity="0.3" />
                <Label Content="F R E E Z E  Y O U R  W O R R I E S ," HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,546,0,0" Foreground="White" Width="168" Height="22" FontSize="10" FontWeight="Bold"/>
                <Label Content="L E T  U S  H A N D L E  I T " HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,568,0,0" Foreground="White" Width="122" Height="22" FontSize="10"/>
            </Grid>
        </Border>

        <!-- Left Side: Register Form -->
        <Border Grid.Column="0" Background="LightGray" Padding="40">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Create Account"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20" />

                <TextBox x:Name="Username"
                         materialDesign:HintAssist.Hint="Username"
                         Foreground="Black"
                         Background="Transparent"
                         BorderBrush="White"
                         Margin="0,0,0,5"
                         Padding="10"
                         Text="{Binding Username, Mode=TwoWay}" />

                <TextBlock Text="{Binding UsernameError}" Foreground="Red" Visibility="{Binding UsernameError, Converter={StaticResource NullOrWhiteSpaceToVisibilityConverter}}" />

                <TextBox x:Name="EmailTextBox"
                         materialDesign:HintAssist.Hint="Email"
                         Foreground="Black"
                         Background="Transparent"
                         BorderBrush="White"
                         Margin="0,0,0,5"
                         Padding="10"
                         Text="{Binding Email, Mode=TwoWay}" />

                <TextBlock Text="{Binding EmailError}" Foreground="Red" Visibility="{Binding EmailError, Converter={StaticResource NullOrWhiteSpaceToVisibilityConverter}}" />

                <TextBox x:Name="PhoneNumberTextBox"
                         materialDesign:HintAssist.Hint="Phone Number"
                         Foreground="Black"
                         Background="Transparent"
                         BorderBrush="White"
                         Margin="0,0,0,5"
                         Padding="10"
                         Text="{Binding PhoneNumber, Mode=TwoWay}" />

                <TextBlock Text="{Binding PhoneError}" Foreground="Red" Visibility="{Binding PhoneError, Converter={StaticResource NullOrWhiteSpaceToVisibilityConverter}}" />

                <PasswordBox x:Name="PasswordBox"
                             materialDesign:HintAssist.Hint="Password"
                             Foreground="Black"
                             Background="Transparent"
                             BorderBrush="White"
                             Margin="0,0,0,5"
                             Padding="10"
                             helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}" />

                <TextBlock Text="{Binding PasswordError}" Foreground="Red" Visibility="{Binding PasswordError, Converter={StaticResource NullOrWhiteSpaceToVisibilityConverter}}" />

                <PasswordBox x:Name="ConfirmPasswordPasswordBox"
                             materialDesign:HintAssist.Hint="Confirm Password"
                             Foreground="Black"
                             Background="Transparent"
                             BorderBrush="White"
                             Margin="0,0,0,5"
                             Padding="10"
                             helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" />

                <TextBlock Text="{Binding ConfirmPasswordError}" Foreground="Red" Visibility="{Binding ConfirmPasswordError, Converter={StaticResource NullOrWhiteSpaceToVisibilityConverter}}" />

                <ComboBox x:Name="ChooseRoleComboBox"
                          materialDesign:HintAssist.Hint="Choose Role"
                          Foreground="Black"
                          Background="Transparent"
                          BorderBrush="White"
                          ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,20">
                    <ComboBox.InputBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding RegisterCommand}" />
                    </ComboBox.InputBindings>
                </ComboBox>

                <Button Content="Register"
                        Background="Blue"
                        Command="{Binding RegisterCommand}"
                        Width="Auto"
                        IsEnabled="{Binding HasError, Converter={StaticResource NullOrWhiteSpaceToVisibilityConverter}}" />

                <Button Content="Cancel"
                        Background="Red"
                        Command="{Binding CancelCommand}"
                        Width="270"
                        Margin="20" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

<UserControl x:Class="ProjectManager.Views.Identities.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:ProjectManager.Helpers"
             xmlns:converters="clr-namespace:ProjectManager.Converters"
             xmlns:viewModels="clr-namespace:ProjectManager.ViewModels.Identities"
             Height="Auto" Width="Auto"
             FlowDirection="LeftToRight"> 
   

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding ShowAddUserFormCommand}" />
        <KeyBinding Gesture="Ctrl+R" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status Bar -->
        <StatusBar Grid.Row="0" Background="WhiteSmoke">
            <StatusBarItem>
                <TextBox Width="200"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Search users..."
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StatusBarItem>
            
            <StatusBarItem>
                <Button Content="Add New User"
                        Command="{Binding ShowAddUserFormCommand}"
                        ToolTip="Ctrl+N"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StatusBarItem>

            <StatusBarItem>
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Ctrl+R"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StatusBarItem>

            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyTextStyle}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- User List -->
            <DataGrid ItemsSource="{Binding Users}"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      SelectedItem="{Binding SelectedUser}"
                      IsReadOnly="True"
                      Margin="10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding UserName}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="*"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Roles}" Width="*"/>

                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Edit">
                                        <materialDesign:PackIcon Kind="Pencil" Foreground="Blue"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Delete">
                                        <materialDesign:PackIcon Kind="Delete" Foreground="Red"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- User Form -->
            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Left" Background="Gray"/>

            <Border Grid.Column="1" Width="350" Background="WhiteSmoke"
                    Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToEyeIconConverter}}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding FormTitle}" 
                               FontSize="16"
                               FontWeight="Bold"
                               Style="{StaticResource HeadingTextStyle}"
                               Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1">
                        <TextBox materialDesign:HintAssist.Hint="Username"
                                 Text="{Binding CurrentUser.UserName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding UserNameError}" Foreground="Red"/>

                        <TextBox materialDesign:HintAssist.Hint="Email"
                                 Text="{Binding CurrentUser.Email, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5,0,5"/>
                        <TextBlock Text="{Binding EmailError}" Foreground="Red"/>

                        <TextBox materialDesign:HintAssist.Hint="Phone Number"
                                 Text="{Binding CurrentUser.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5,0,5"/>
                        <TextBlock Text="{Binding PhoneError}" Foreground="Red"/>

                        <ComboBox materialDesign:HintAssist.Hint="Role"
                                  ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding CurrentUser.Roles}"
                                  Margin="0,5,0,5"/>
                        <TextBlock Text="{Binding RoleError}" Foreground="Red"/>

                        <PasswordBox x:Name="PasswordBox"
                                     materialDesign:HintAssist.Hint="Password"
                                     Foreground="Black"
                                     Background="Transparent"
                                     BorderBrush="White"
                                     Margin="0,5,0,5"
                                     Padding="10"
                                     helpers:PasswordBoxHelper.BoundPassword="{Binding CurrentUser.Password, Mode=TwoWay}" />
                        <TextBlock Text="{Binding PasswordError}" Foreground="Red"
                                   Visibility="{Binding PasswordError, Converter={StaticResource NullOrWhiteSpaceToVisibilityConverter}}" />

                        <PasswordBox x:Name="ConfirmPasswordPasswordBox"
                                     materialDesign:HintAssist.Hint="Confirm Password"
                                     Foreground="Black"
                                     Background="Transparent"
                                     BorderBrush="White"
                                     Margin="0,5,0,5"
                                     Padding="10"
                                     helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" />
                        <TextBlock Text="{Binding ConfirmPasswordError}" Foreground="Red"
                                   Visibility="{Binding ConfirmPasswordError, Converter={StaticResource NullOrWhiteSpaceToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Save"
                                Command="{Binding SaveUserCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"/>
                        <Button Content="Cancel"
                                Command="{Binding CancelFormCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

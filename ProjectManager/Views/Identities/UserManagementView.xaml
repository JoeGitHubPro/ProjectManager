<UserControl x:Class="ProjectManager.Views.Identities.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:ProjectManager.Helpers"
             xmlns:converters="clr-namespace:ProjectManager.Converters"
             FlowDirection="LeftToRight">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <TextBox Width="250"
                     Margin="0 0 10 0"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search users...">
            </TextBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding RefreshCommand}" 
                        Style="{StaticResource OutlinedButtonStyle}" 
                        Margin="0,0,10,0"
                        ToolTip="Refresh (Ctrl+R)">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding ShowAddUserFormCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Add New (Ctrl+N)">
                    <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- User List -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Style="{StaticResource MaterialDesignDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding UserName}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="*"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Roles}" Width="*"/>

                    <DataGridTemplateColumn Header="Actions" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource OutlinedButtonStyle}"
                                            Margin="0,0,5,0"
                                            ToolTip="Edit">
                                        <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource OutlinedButtonStyle}"
                                            ToolTip="Delete">
                                        <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Foreground="DarkRed"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- User Form -->
            <Border Grid.Column="2" 
                    Width="350" 
                    Padding="15" 
                    FocusManager.FocusedElement="{Binding ElementName=UsernameTextBox}"
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Background="White"
                    Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" 
                                   Style="{StaticResource HeadingTextStyle}" 
                                   Margin="0,0,0,15"/>

                        <Label Content="Username"/>
                        <TextBox x:Name="UsernameTextBox"
                                 Text="{Binding CurrentUser.UserName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 Margin="0,0,0,5"
                                 helpers:EnterKeyTraversal.IsEnabled="True"/>
                        <TextBlock Text="{Binding UserNameError}" 
                                   Foreground="Red"
                                   Visibility="{Binding UserNameError, Converter={StaticResource NullOrWhiteSpaceToVisibilityConverter}}"/>

                        <Label Content="Email"/>
                        <TextBox Text="{Binding CurrentUser.Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 Margin="0,10,0,5"
                                 helpers:EnterKeyTraversal.IsEnabled="True"/>
                        <TextBlock Text="{Binding EmailError}" 
                                   Foreground="Red"
                                   Visibility="{Binding EmailError, Converter={StaticResource NullOrWhiteSpaceToVisibilityConverter}}"/>

                        <Label Content="Phone Number"/>
                        <TextBox Text="{Binding CurrentUser.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 Margin="0,10,0,5"
                                 helpers:EnterKeyTraversal.IsEnabled="True"/>
                        <TextBlock Text="{Binding PhoneError}" 
                                   Foreground="Red"
                                   Visibility="{Binding PhoneError, Converter={StaticResource NullOrWhiteSpaceToVisibilityConverter}}"/>

                        <Label Content="Role"/>
                        <ComboBox ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding CurrentUser.Roles}"
                                  Style="{StaticResource MaterialDesignComboBox}" 
                                  Margin="0,10,0,5"
                                  helpers:EnterKeyTraversal.IsEnabled="True"/>
                        <TextBlock Text="{Binding RoleError}" 
                                   Foreground="Red"
                                   Visibility="{Binding RoleError, Converter={StaticResource NullOrWhiteSpaceToVisibilityConverter}}"/>

                        <Label Content="Password"/>
                        <PasswordBox helpers:PasswordBoxHelper.BoundPassword="{Binding CurrentUser.Password, Mode=TwoWay}"
                                     Style="{StaticResource MaterialDesignPasswordBox}"
                                     Margin="0,10,0,5"
                                     helpers:EnterKeyTraversal.IsEnabled="True"/>
                        <TextBlock Text="{Binding PasswordError}" 
                                   Foreground="Red"
                                   Visibility="{Binding PasswordError, Converter={StaticResource NullOrWhiteSpaceToVisibilityConverter}}"/>

                        <Label Content="Confirm Password"/>
                        <PasswordBox helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}"
                                     Style="{StaticResource MaterialDesignPasswordBox}"
                                     Margin="0,10,0,5"
                                     helpers:EnterKeyTraversal.IsEnabled="True"/>
                        <TextBlock Text="{Binding ConfirmPasswordError}" 
                                   Foreground="Red"
                                   Visibility="{Binding ConfirmPasswordError, Converter={StaticResource NullOrWhiteSpaceToVisibilityConverter}}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Command="{Binding SaveUserCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20"/>
                            </Button>
                            <Button Command="{Binding CancelFormCommand}" 
                                    Style="{StaticResource OutlinedButtonStyle}">
                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
<Window x:Class="ProjectManager.Views.Identities.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Register User"  
        Language="en-US"
        Height="500" 
        Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="LightGray"
        BorderBrush="Black"
        BorderThickness="2"
        WindowStyle="None"
        FlowDirection="LeftToRight"
        FocusManager.FocusedElement="{Binding ElementName=UsernameTextBox}">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="ESC" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Register User" 
                   Foreground="#A5A5A5"
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"
                   Margin="0,20,0,20"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="20,0,20,0">
            <TextBox Name="UsernameTextBox"
                     materialDesign:HintAssist.Hint="Username"
                     Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="Black"
                     Background="Transparent"
                     BorderBrush="Gray"
                     Padding="10" KeyDown="UsernameTextBox_KeyDown"/>

            <TextBlock Text="{Binding UserNameError}" Foreground="Red" FontSize="12"/>

            <TextBox Name="EmailTextBox"
                     materialDesign:HintAssist.Hint="Email"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="Black"
                     Background="Transparent"
                     BorderBrush="Gray"
                     Padding="10" KeyDown="EmailTextBox_KeyDown"/>

            <TextBlock Text="{Binding EmailError}" Foreground="Red" FontSize="12"/>

            <TextBox Name="PhoneTextBox"
                     materialDesign:HintAssist.Hint="Phone Number"
                     Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="Black"
                     Background="Transparent"
                     BorderBrush="Gray"
                     Padding="10" KeyDown="PhoneTextBox_KeyDown"/>

            <TextBlock Text="{Binding PhoneNumberError}" Foreground="Red" FontSize="12"/>

            <ComboBox Name="RoleComboBox"
                      materialDesign:HintAssist.Hint="Select Role"
                      Padding="10"
                      ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding SelectedRole, UpdateSourceTrigger=PropertyChanged}"
                      Foreground="Black"
                      BorderBrush="Gray">
                <ComboBox.InputBindings>
                    <KeyBinding Command="{Binding SaveCommand}" Key="Enter" />
                </ComboBox.InputBindings>
            </ComboBox>

            <TextBox Name="NewPasswordTextBox"
                     materialDesign:HintAssist.Hint="New Password (Optional)"
                     Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="Black"
                     Background="Transparent"
                     BorderBrush="Gray"
                     Padding="10"/>

            <TextBlock Text="{Binding NewPasswordError}" Foreground="Red" FontSize="12"/>

            <TextBox Name="ConfirmNewPasswordTextBox"
                     materialDesign:HintAssist.Hint="Confirm New Password"
                     Text="{Binding ConfirmNewPassword, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="Black"
                     Background="Transparent"
                     BorderBrush="Gray"
                     Padding="10"/>

            <TextBlock Text="{Binding ConfirmNewPasswordError}" Foreground="Red" FontSize="12"/>

            <TextBlock Text="{Binding RoleError}" Foreground="Red" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button Content="Save"
                    ToolTip="Ctrl + S"
                    Background="Gray"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    Height="40"
                    Padding="15,10"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding SaveCommand}"/>

            <Button Content="Cancel"
                    ToolTip="ESC"
                    Background="DarkGray"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    Height="40"
                    Padding="15,10"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding CancelCommand}"
                    Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>

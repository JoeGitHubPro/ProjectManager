<Window x:Class="ProjectManager.Views.Identities.LogInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:ProjectManager.Helpers"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800"
        Language="en-US"
        FlowDirection="LeftToRight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource WhiteBrush}" WindowStyle="None">

    <Window.InputBindings>
        <KeyBinding Gesture="ESC" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Left side: Logo and Slogan -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}">
            <Grid>
                <Image Source="/Assets/icepharmacy-horizontal.png"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" Height="65" Width="250" Opacity="0.7" />
                <Image Source="/Assets/snowflakewhite.png"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="316,0,0,375" Height="99" Width="119" Opacity="0.3" />
                <Label Content="F R E E Z E  Y O U R  W O R R I E S ,"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,378,0,0"
                       Foreground="{StaticResource WhiteBrush}"
                       Width="168"
                       Height="22"
                       FontSize="10"
                       FontWeight="Bold"/>
                <Label Content="L E T  U S  H A N D L E  I T "
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,400,0,0"
                       Foreground="{StaticResource WhiteBrush}"
                       Width="122"
                       Height="22"
                       FontSize="10"/>
            </Grid>
        </Border>

        <!-- Right side: Login Form -->
        <Border Grid.Column="1" Background="{StaticResource WhiteBrush}" Padding="40">
            <StackPanel VerticalAlignment="Center" FocusManager.FocusedElement="{Binding ElementName=UsernameOrEmailTextBox}">
                <TextBlock Text="Welcome Back"
                           Foreground="{StaticResource PrimaryBrush}"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBox x:Name="UsernameOrEmailTextBox"
                         Text="{Binding UsernameOrEmail, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Username or Email"
                         Foreground="{StaticResource DarkBrush}"
                         Background="Transparent"
                         BorderBrush="{StaticResource PrimaryBrush}"
                         Margin="0,0,0,5"
                         Padding="10" KeyDown="UsernameOrEmailTextBox_KeyDown">
                </TextBox>
                <TextBlock Text="{Binding UsernameError}"
                           FontSize="10"
                           Margin="20,0,0,10"
                           Foreground="#b00404"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="PasswordBox"
                                 materialDesign:HintAssist.Hint="Password"
                                 Foreground="{StaticResource DarkBrush}"
                                 Background="Transparent"
                                 BorderBrush="{StaticResource PrimaryBrush}"
                                 Margin="0,0,0,5"
                                 Padding="10"
                                 helpers:PasswordBoxHelper.BoundPassword="{Binding Password}"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToEyeIconConverter}, ConverterParameter=False}">
                        <PasswordBox.InputBindings>
                            <KeyBinding Command="{Binding LoginCommand}" Key="Enter"/>
                        </PasswordBox.InputBindings>
                    </PasswordBox>

                    <TextBox x:Name="VisiblePasswordBox"
                             materialDesign:HintAssist.Hint="Password"
                             Foreground="{StaticResource DarkBrush}"
                             Background="Transparent"
                             BorderBrush="{StaticResource PrimaryBrush}"
                             Margin="0,0,0,5"
                             Padding="10"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToEyeIconConverter}, ConverterParameter=True}"
                             Grid.Column="0">
                        <TextBox.InputBindings>
                            <KeyBinding Command="{Binding LoginCommand}" Key="Enter"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="5"
                            Command="{Binding TogglePasswordVisibilityCommand}" 
                            Grid.Column="1">
                        <materialDesign:PackIcon Kind="EyeOutline"
                                                 Width="20" Height="20"
                                                 Foreground="{StaticResource PrimaryBrush}"/>
                    </Button>
                </Grid>

                <TextBlock Text="{Binding PasswordError}"
                           FontSize="10"
                           Margin="20,0,0,10"
                           Foreground="#b00404"/>

                <Button Content="Log In"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="{StaticResource WhiteBrush}"
                        FontSize="16"
                        FontWeight="Bold"
                        Padding="15,10"
                        HorizontalAlignment="Stretch"
                        BorderThickness="0"
                        Cursor="Hand"
                        Height="40"
                        Command="{Binding LoginCommand}"/>

                <TextBlock Text="Forgot Password?"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0"
                           Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

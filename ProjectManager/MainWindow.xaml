<Window x:Class="ProjectManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ProjectManager.Views"
        Title="Project Manager" Height="600" Width="900">
    
    <Grid>
        <TabControl>
            <TabItem Header="Consumers">
                <views:ConsumerView DataContext="{Binding ConsumerVM}"/>
            </TabItem>
            <TabItem Header="Project Categories">
                <views:ProjectCategoryView DataContext="{Binding ProjectCategoryVM}" />
            </TabItem>      
            <TabItem Header="Projects">
                <views:ProjectView DataContext="{Binding ProjectVM}" />
            </TabItem>
            <TabItem Header="Project Order">
                <views:ProjectOrderView DataContext="{Binding ProjectOrderVM}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>

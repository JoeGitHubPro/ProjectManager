<Window x:Class="ProjectManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Project Manager"
        WindowState="Maximized"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        Background="#F0F0F0">

    <Window.Resources>
        <!-- Drop shadow for window border -->
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="15" ShadowDepth="0" Opacity="0.2" />
    </Window.Resources>

    <Border Background="#FAFAFA" CornerRadius="8" Effect="{StaticResource WindowShadow}" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Header -->
                <Border Background="White" Padding="20" Margin="20,20,20,10" CornerRadius="8">
                    <TextBlock Text="Project Manager - Ice Code Co."
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#2D2D30"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Toolbar -->
                <Border Background="White" Padding="15" Margin="20,0,20,10" CornerRadius="6" Grid.Row="1">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" ItemHeight="40" ItemWidth="Auto" Margin="0">
                        <TextBox Width="300" Height="32"
                                 x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Margin="5,0"
                                 ToolTip="Search by project..."
                                 Padding="10"/>

                        <Button Content="➕ Add Project"
                                Command="{Binding AddNewProjectCommand}"
                                Margin="5,0"
                                Padding="12,6"
                                Background="#4CAF50" Foreground="White" FontWeight="Bold"
                                BorderBrush="#388E3C"/>

                        <Button Content="🔄 Refresh"
                                Command="{Binding RefreshProjectsCommand}"
                                Margin="5,0"
                                Padding="12,6"
                                Background="#2196F3" Foreground="White" FontWeight="Bold"
                                BorderBrush="#1976D2"/>
                    </WrapPanel>
                </Border>

                <!-- DataGrid -->
                <Border Grid.Row="2" Background="White" Margin="20" CornerRadius="6" Padding="10">
                    <DataGrid ItemsSource="{Binding FilteredProjects}"
                              SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              ColumnWidth="*"
                              RowHeight="35"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Margin="5"
                              VerticalGridLinesBrush="#EEE"
                              HorizontalGridLinesBrush="#EEE">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Project ID" Binding="{Binding ProjectId}" Width="Auto"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding ProjectDetails}"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding ProjectPrice}"/>
                            <DataGridTextColumn Header="Folder Serial" Binding="{Binding FolderSerial}"/>
                            <DataGridTextColumn Header="Owner" Binding="{Binding OwnerName}"/>
                            <DataGridTextColumn Header="Register" Binding="{Binding OwnerCommercialRegister}"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding OwnerPhone}"/>
                            <DataGridTextColumn Header="System" Binding="{Binding OwnerSystemDetails}"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>

                            <DataGridTemplateColumn Header="Actions">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="📂" ToolTip="Locate"
                                                    Command="{Binding DataContext.LocateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Margin="2"
                                                    Width="30" Height="30"/>
                                            <Button Content="✏️" ToolTip="Edit"
                                                    Command="{Binding DataContext.EditProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Margin="2"
                                                    Width="30" Height="30"/>
                                            <Button Content="🗑️" ToolTip="Delete"
                                                    Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Margin="2"
                                                    Width="30" Height="30"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Border>
</Window>
